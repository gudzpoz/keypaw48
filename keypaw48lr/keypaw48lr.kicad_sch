	(text "Trackball sensor (right only)\nUsing a tricky 1.9V VDD for PAW3395.\nDesigned for right board.\nNo soldering needed for left board."
		(exclude_from_sim no)
		(at 38.1 120.65 0)
		(effects
			(font
				(size 1.27 1.27)
			)
		)
		(uuid "21a9fda2-1213-4b8d-a844-261158897f8a")
	)
	(text "Battery switch\nLeft board: solder jumper\nRight board: solder switch\nJ1: BATT, J2: connects two boards"
		(exclude_from_sim no)
		(at 46.99 103.505 0)
		(effects
			(font
				(size 1.27 1.27)
			)
		)
		(uuid "4426187a-0275-48b2-8a6f-3f9902247169")
	)
	(text "Mouse wheel (left only)\nWe don't use PAW3395 on the left side,\nso we reuse the pins for a mouse wheel."
		(exclude_from_sim no)
		(at 34.29 166.37 0)
